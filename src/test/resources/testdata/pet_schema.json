{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["available", "pending", "sold"]
    },
    "category": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "photoUrls": {
      "type": "array"
    },
    "tags": {
      "type": "array"
    }
  },
  "required": ["id", "name", "photoUrls"]
}